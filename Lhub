local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({ 
    Name = "⚡ Greedy Growers - Ultimate Edition", 
    LoadingTitle = "Đang khởi động hệ thống tối ưu VIP...", 
    LoadingSubtitle = "By Gemini",
    KeySystem = false 
})

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local Tab = Window:CreateTab("⚡ Điều Khiển & Cảnh Báo", 4483362458)
local SettingsTab = Window:CreateTab("⚙️ Tùy Chỉnh Nâng Cao", 4483362458)

local StatusLabel = Tab:CreateLabel("⏱️ Trạng thái: Đang sẵn sàng...")
local isEarlyWarningEnabled = false
local isAutoHarvestEnabled = false
local harvestRadius = 35 -- Tầm với mặc định
local walkSpeedValue = 16

Tab:CreateToggle({
   Name = "🚨 Bật Cảnh Báo Sét Thông Minh",
   CurrentValue = false,
   Callback = function(v)
      isEarlyWarningEnabled = v
      if v then
          Rayfield:Notify({Title = "Đã bật!", Content = "Hệ thống canh chừng đã hoạt động.", Duration = 2})
          StatusLabel:Set("⏱️ Trạng thái: Đang theo dõi môi trường...")
      else
          StatusLabel:Set("⏱️ Trạng thái: Đã tắt")
      end
   end,
})

Tab:CreateToggle({
   Name = "⚡ Tự Động Thu Hoạch Chớp Nhoáng (Auto Harvest)",
   CurrentValue = false,
   Callback = function(v)
      isAutoHarvestEnabled = v
      if v then
          Rayfield:Notify({Title = "Auto Harvest: Bật", Content = "Sẵn sàng gom cây tốc độ cao khi có lệnh.", Duration = 2})
      else
          Rayfield:Notify({Title = "Auto Harvest: Tắt", Content = "Đã tắt tính năng tự động.", Duration = 2})
      end
   end,
})

SettingsTab:CreateSlider({
   Name = "🎯 Phạm vi quét thu hoạch (Studs)",
   Range = {10, 100},
   Increment = 5,
   CurrentValue = 35,
   Flag = "HarvestRadiusSlider",
   Callback = function(v)
      harvestRadius = v
   end,
})

SettingsTab:CreateSlider({
   Name = "🏃 Tốc độ di chuyển (WalkSpeed)",
   Range = {16, 100},
   Increment = 1,
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(v)
      walkSpeedValue = v
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
          LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeedValue
      end
   end,
})

-- Tự động áp dụng lại WalkSpeed khi hồi sinh
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        humanoid.WalkSpeed = walkSpeedValue
    end
end)

-- Hàm kích hoạt thu hoạch tối ưu hóa quét ProximityPrompt toàn diện & siêu tốc
local function triggerHarvest()
    pcall(function()
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart

        -- Quét tất cả Prompt trong phạm vi thiết lập
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parentPart = obj.Parent
                if parentPart and parentPart:IsA("BasePart") then
                    if (parentPart.Position - hrp.Position).Magnitude <= harvestRadius then
                        -- Kích hoạt nhiều lần liên tục cực nhanh cho mỗi prompt để đảm bảo không bị kẹt mạng (lag)
                        task.spawn(function()
                            fireproximityprompt(obj)
                            task.wait(0.05)
                            fireproximityprompt(obj)
                        end)
                    end
                end
            end
        end
    end)
end

-- Vòng lặp giám sát cải tiến tốc độ cao (0.2s)
task.spawn(function()
    local lastAlertTime = 0
    while true do
        task.wait(0.2) -- Phản hồi nhanh hơn bản cũ
        if isEarlyWarningEnabled or isAutoHarvestEnabled then
            pcall(function()
                local triggered = false
                
                -- Kiểm tra âm thanh hoặc hiệu ứng sấm sét / mưa bão trong Workspace
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Sound") and (obj.SoundId:find("storm") or obj.SoundId:find("thunder") or obj.SoundId:find("lightning")) and obj.Playing then
                        triggered = true
                        break
                    elseif obj:IsA("ParticleEmitter") and (obj.Name:lower():find("rain") or obj.Name:lower():find("storm")) and obj.Enabled then
                        triggered = true
                        break
                    end
                end

                if triggered and (os.time() - lastAlertTime > 8) then
                    lastAlertTime = os.time()
                    
                    if isAutoHarvestEnabled then
                        StatusLabel:Set("⚡ ĐÃ KÍCH HOẠT THU HOẠCH ĐÓN ĐẦU!")
                        Rayfield:Notify({
                            Title = "⚡ AUTO HARVEST!",
                            Content = "Đã gom toàn bộ cây trong bán kính " .. harvestRadius .. " studs!",
                            Duration = 3,
                            Image = 4483362458,
                        })
                        triggerHarvest()
                    elseif isEarlyWarningEnabled then
                        StatusLabel:Set("⚠️ CẢNH BÁO: PHÁT HIỆN SẤM SÉT!")
                        Rayfield:Notify({
                            Title = "⚠️ BÁO ĐỘNG ĐỎ!",
                            Content = "Thu hoạch ngay lập tức!",
                            Duration = 3,
                            Image = 4483362458,
                        })
                    end
                    
                    task.delay(3, function()
                        if isEarlyWarningEnabled or isAutoHarvestEnabled then
                            StatusLabel:Set("⏱️ Trạng thái: Tiếp tục canh chừng...")
                        end
                    end)
                end
            end)
        end
    end
end)

Rayfield:Notify({Title = "Tải thành công!", Content = "Script Ultimate đã sẵn sàng sử dụng.", Duration = 3})
