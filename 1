-- ========================================================
-- TÌM TRẠNG THÁI CÂY
-- ========================================================

local matureAttributes = {
    "Mature",
    "Matured",
    "IsMature",
    "FullyGrown",
    "FullyGrown",
    "Ready",
    "Harvestable",
    "CanHarvest",
    "Grown"
}

local function findMatureState(obj)

    local current = obj

    for _ = 1, 6 do

        if not current then
            break
        end

        for _, attributeName in ipairs(matureAttributes) do

            local value =
                current:GetAttribute(attributeName)

            if value ~= nil then

                if typeof(value) == "boolean" then
                    return value
                end

                if typeof(value) == "number" then
                    return value > 0
                end

                if typeof(value) == "string" then

                    local v =
                        lower(value)

                    if v == "true"
                        or v == "ready"
                        or v == "mature"
                        or v == "matured"
                        or v == "grown"
                        or v == "harvestable" then

                        return true
                    end

                    if v == "false"
                        or v == "growing"
                        or v == "immature"
                        or v == "notready" then

                        return false
                    end
                end
            end
        end

        for _, name in ipairs(matureAttributes) do

            local valueObject =
                current:FindFirstChild(name)

            if valueObject then

                if valueObject:IsA("BoolValue") then
                    return valueObject.Value
                end

                if valueObject:IsA("NumberValue") then
                    return valueObject.Value > 0
                end

                if valueObject:IsA("StringValue") then

                    local v =
                        lower(valueObject.Value)

                    if v == "true"
                        or v == "ready"
                        or v == "mature"
                        or v == "grown" then

                        return true
                    end

                    if v == "false"
                        or v == "growing"
                        or v == "immature" then

                        return false
                    end
                end
            end
        end

        current = current.Parent
    end

    return nil
end

