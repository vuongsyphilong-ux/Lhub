local function isHarvestPrompt(prompt)

    if not prompt:IsA("ProximityPrompt") then
        return false
    end

    if not prompt.Enabled then
        return false
    end

    local parent = prompt.Parent

    if not parent then
        return false
    end

    local promptName =
        lower(prompt.Name)

    local actionText =
        lower(prompt.ActionText)

    local objectText =
        lower(prompt.ObjectText)

    local parentName =
        lower(parent.Name)

    local grandParentName = ""

    if parent.Parent then
        grandParentName =
            lower(parent.Parent.Name)
    end

    local combined =
        promptName .. " " ..
        actionText .. " " ..
        objectText .. " " ..
        parentName .. " " ..
        grandParentName

    local keywords = {
        "harvest",
        "crop",
        "plant",
        "fruit",
        "vegetable",
        "farm",
        "produce",
        "collect"
    }

    local matched = false

    for _, keyword in ipairs(keywords) do

        if combined:find(keyword, 1, true) then
            matched = true
            break
        end
    end

    if not matched then
        return false
    end

    -- Nếu game cung cấp trạng thái trưởng thành
    -- thì bắt buộc phải trưởng thành.
    local mature =
        findMatureState(parent)

    if mature ~= nil then
        return mature
    end

    -- Nếu ActionText đã trực tiếp là Harvest/Collect
    -- thì cho phép prompt.
    if actionText:find("harvest", 1, true)
        or actionText:find("collect", 1, true)
        or actionText:find("pickup", 1, true) then

        return true
    end

    return false
end

